SMTP_PROVIDER=gmail

# Required for delivery. Use an app password or SMTP-specific credential.
SMTP_USER=sender@example.com
SMTP_PASSWORD=replace-with-app-password
MAIL_FROM=sender@example.com

# Optional message defaults. CLI flags override these values.
MAIL_TO=recipient@example.com
MAIL_SUBJECT=Notification test
MAIL_BODY=This is a test message.

# Custom provider only:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_TIMEOUT=15
